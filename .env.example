# Rost és Umami — környezeti változók (MINTA). Másold .env-be és töltsd ki.
# A .env sosem kerül a gitbe. A PUBLIC_* értékek az adminból, a titkok kezelése bizalmas.

# --- Kötelező ---
SESSION_SECRET=            # openssl rand -hex 32
PUBLIC_STORE_DOMAIN=rost-es-umami.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_CHECKOUT_DOMAIN=rost-es-umami.myshopify.com

# --- Analytics / Customer Account ---
# PUBLIC_STOREFRONT_ID: csak Hydrogen channelnél van; Headless-nél NINCS → hagyd üresen
# (csak az analytics használja, minden más nélküle is működik).
PUBLIC_STOREFRONT_ID=
# SHOP_ID: numerikus shop id. A PUBLIC_CUSTOMER_ACCOUNT_API_URL-ben benne van,
# vagy Storefront API: { shop { id } } → gid://shopify/Shop/<SHOP_ID>
SHOP_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# --- Deploy / futtatás ---
SITE_DOMAIN=rost-umami.kebodev.hu
NODE_ENV=production
